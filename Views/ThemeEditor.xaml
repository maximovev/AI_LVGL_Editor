<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2022/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LvglProjectEditor.Views.ThemeEditor"
             Title="Theme Editor">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
        <!-- Основная информация -->
        <Frame Grid.Row="0" Grid.Column="0" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackLayout Spacing="10">
                <Entry Placeholder="Theme Name" x:Name="ThemeNameEntry" />
                <Picker x:Name="ThemeTypePicker" ItemsSource="Light, Dark, System, High Contrast" SelectedItem="Dark" />
                <Entry Placeholder="Theme Description" x:Name="ThemeDescriptionEntry" />
                
                <Label Text="Primary Color:" FontSize="12" />
                <Picker x:Name="PrimaryColorPicker" ItemsSource="Red, Blue, Green, Purple, Orange" SelectedItem="Blue" />
                
                <Label Text="Background Color:" FontSize="12" />
                <Picker x:Name="BackgroundColorPicker" ItemsSource="White, Black, Gray, LightGray" SelectedItem="Black" />
            </StackLayout>
        </Frame>
        
        <!-- Кнопки действий -->
        <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="End">
            <Button Text="Save Theme" Clicked="OnSaveThemeClicked" />
            <Button Text="Delete Theme" Clicked="OnDeleteThemeClicked" />
        </StackLayout>
    </Grid>
</ContentPage>